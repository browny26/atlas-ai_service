# Copy to .env and fill in. All variables are optional except the API key in production.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM provider (any OpenAI-compatible API) ---
# Groq (production):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant
# Ollama (local, free, no key): run `ollama pull mistral:7b`, then
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=mistral:7b

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2500
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Generation ---
GENERATION_MAX_ATTEMPTS=3
ENABLE_FALLBACK=true

# --- Service-to-service auth (header X-API-Key). Empty = disabled. ---
SERVICE_API_KEY=change-me
